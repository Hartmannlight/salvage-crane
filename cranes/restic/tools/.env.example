# Core instance settings
MACHINE=my-docker-host
TZ=UTC

# Images
SALVAGE_IMAGE=ghcr.io/hartmannlight/salvage:master
RESTIC_CRANE_IMAGE=salvage-crane-restic:local
BUILD_RESTIC_IMAGE=true

# Tide defaults
TIDE_NAME=nightly
TIDE_CRON='0 3 * * *'
TIDE_GROUPING=project
TIDE_MAX_CONCURRENT=1

# Repository configuration
# Prefer setting REPO_BASE_LOCATION directly.
# If empty, install/preflight derive it from SFTP_* variables.
REPO_BASE_LOCATION=
SFTP_HOST=
SFTP_USER=
SFTP_PORT=23
SFTP_PATH=salvage

# Restic crane behavior
SINGLE_REPO=true
RESTIC_RETRY_LOCK=2h
VERIFY_SNAPSHOT=true
VERIFY_REPOSITORY_CHECK=false
VERIFY_REPOSITORY_CHECK_READ_DATA_SUBSET=1/200
FORGET_ARGS=
DO_PRUNE=false

# SSH input files on host (used for install.sh copy into Docker volume)
SSH_PRIVATE_KEY_SOURCE=
SSH_KNOWN_HOSTS_SOURCE=
STRICT_HOST_KEY_CHECKING=true

# Restic password input
# Option A: set RESTIC_PASSWORD directly.
# Option B: provide RESTIC_PASSWORD_FILE_SOURCE path.
RESTIC_PASSWORD=
RESTIC_PASSWORD_FILE_SOURCE=

# Volume names used by crane mounts
RESTIC_SSH_VOLUME=salvage-restic-ssh
RESTIC_SECRETS_VOLUME=salvage-restic-secrets
RESTIC_CACHE_VOLUME=salvage-restic-cache

# Secret filename inside RESTIC_SECRETS_VOLUME
RESTIC_PASSWORD_FILENAME=restic_password
